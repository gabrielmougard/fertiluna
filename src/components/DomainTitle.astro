---
/**
 * DomainTitle — the colorful, locale-aware wordmark in the header.
 * Renders "suivi-grossesse.fr" (FR) or "pregnancy-tracker.org" (EN) using the
 * Gokart-Bubble display font. Each character animates in on first paint and
 * a slow hue-shift loops a gradient across the whole word; punctuation gets
 * extra emphasis so the URL reads more like a logo than text.
 */
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  href?: string;
}
const { locale, href = "/" } = Astro.props as Props;
const text = t("brand.domain", locale);
const chars = [...text];

const isAccent = (c: string) => c === "." || c === "-";
---

<a
  class="domain-title"
  href={href}
  aria-label={text}
>
  {
    chars.map((c, i) => (
      <span
        class:list={["dt-ch", { "dt-accent": isAccent(c) }]}
        style={`--i:${i}`}
        aria-hidden="true"
      >
        {c}
      </span>
    ))
  }
</a>

<style>
  .domain-title {
    display: inline-flex;
    align-items: baseline;
    font-family: "Gokart Bubble", "Inter", sans-serif;
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    line-height: 1;
    letter-spacing: 0.005em;
    text-decoration: none;
    user-select: none;
    white-space: nowrap;
    padding: 4px 2px;
  }
  .domain-title:hover {
    text-decoration: none;
  }
  .dt-ch {
    display: inline-block;
    background: linear-gradient(
      90deg,
      #d6447f 0%,
      #b8336a 18%,
      #7e4b9e 42%,
      #d6447f 65%,
      #7e4b9e 88%,
      #d6447f 100%
    );
    background-size: 300% 100%;
    background-position: calc(var(--i, 0) * -8% + 0%) 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation:
      dt-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1)
        calc(var(--i) * 28ms) both,
      dt-flow 9s ease-in-out infinite calc(var(--i) * 40ms);
    will-change: transform, background-position;
    transform-origin: 50% 100%;
    transition: transform 0.18s ease;
  }
  .dt-accent {
    /* punctuation reads as the brand "spark" — a touch larger + bouncing */
    font-size: 1.1em;
    animation:
      dt-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1)
        calc(var(--i) * 28ms) both,
      dt-flow 9s ease-in-out infinite calc(var(--i) * 40ms),
      dt-bounce 2.4s ease-in-out infinite
        calc(var(--i) * 60ms + 600ms);
  }
  .domain-title:hover .dt-ch {
    animation-play-state: paused;
    transform: translateY(-2px);
  }
  .domain-title:hover .dt-ch:hover {
    transform: translateY(-5px) rotate(-6deg) scale(1.08);
  }

  @keyframes dt-pop {
    0% {
      opacity: 0;
      transform: translateY(10px) rotate(-8deg) scale(0.82);
    }
    60% {
      opacity: 1;
      transform: translateY(-2px) rotate(3deg) scale(1.06);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(0) scale(1);
    }
  }
  @keyframes dt-flow {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  @keyframes dt-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dt-ch,
    .dt-accent {
      animation: none !important;
      opacity: 1;
      transform: none;
      background-position: 0% 50%;
    }
  }
</style>
