---
/**
 * AdSlot — a reusable, responsive, layout-stable ad unit.
 *
 * Two modes, decided at request time (see src/lib/ads.ts):
 *   - placeholder (default / dev / unapproved domain): a labelled box that
 *     reserves the exact space the real ad will take, so turning ads on later
 *     causes zero layout shift (CLS) — important for UX and ad viewability.
 *   - live: a real <ins class="adsbygoogle"> responsive unit. The loader
 *     script is injected once in Base.astro when a publisher id is present.
 *
 * Placements map to the units in docs/AD_SETUP_GUIDE.md. Responsiveness is
 * CSS-driven (see global.css): rails are desktop-only, the leaderboard shrinks
 * to a mobile banner, and `hideMobile` drops a slot entirely on small screens
 * so the UI never feels cluttered with ads on phones (the bulk of our traffic).
 */
interface Props {
  placement: "top" | "inline" | "rail" | "bottom" | "anchor";
  pubId?: string | null;
  slotId?: string | null;
  /** True when real AdSense markup should be emitted (adsLive(cfg)). */
  live?: boolean;
  /** Hide this slot on phones to avoid clutter. */
  hideMobile?: boolean;
  label?: string;
  class?: string;
}
const {
  placement,
  pubId = null,
  slotId = null,
  live = false,
  hideMobile = false,
  label,
  class: className = "",
} = Astro.props;

const sizeClass = `ad-${placement}`;
const classes = [
  "ad-slot",
  sizeClass,
  hideMobile ? "ad-hide-mobile" : "",
  className,
]
  .filter(Boolean)
  .join(" ");

const showReal = live && pubId && slotId;
const defaultLabel = placement === "inline" ? "Espace publicitaire" : "Publicité";
---

{
  showReal ? (
    <aside class={classes} data-ad-placement={placement}>
      <ins
        class="adsbygoogle"
        style="display:block;width:100%;height:100%"
        data-ad-client={pubId}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  ) : (
    <aside class={classes} data-ad-placement={placement} aria-hidden="true">
      <span class="ad-slot__tag">{label ?? defaultLabel}</span>
    </aside>
  )
}
