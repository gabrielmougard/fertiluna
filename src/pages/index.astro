---
import Base from "../layouts/Base.astro";
import TikTokWall from "../components/TikTokWall.astro";
import Icon from "../components/Icon.astro";
import HeroBg from "../components/HeroBg.astro";
import AdSlot from "../components/AdSlot.astro";
import { getAdConfig, adsLive } from "../lib/ads";

const TOOL = "/outils/analyse-courbe";

const ads = getAdConfig(Astro.locals);
const adsOn = adsLive(ads);

// Honest trust signals only. No fabricated user counts or testimonials.
const trust = [
  "Gratuit (vraiment)",
  "Sans inscription",
  "100 % dans le navigateur",
  "Résultat en ~2 min",
];

const tools = [
  {
    href: TOOL,
    star: true,
    title: "Analyse simple de courbe",
    desc: "Entrez vos températures et vos tests LH du cycle. Vous repartez avec une lecture claire : ovulation, phase lutéale, et les petits signaux qui méritent un œil.",
    cta: "Analyser mon cycle",
    available: true,
  },
  {
    href: "#",
    title: "Analyse approfondie (3 cycles)",
    desc: "Comparez plusieurs cycles, repérez les tendances de fond et recevez des pistes de soutien naturel.",
    cta: "Bientôt",
    available: false,
  },
  {
    href: "#",
    title: "Calcul des semaines de grossesse",
    desc: "Test positif ? Calculez où vous en êtes et repartez avec une checklist faite pour vous.",
    cta: "Bientôt",
    available: false,
  },
  {
    href: "#",
    title: "Lecteur de bilan hormonal",
    desc: "FSH, AMH, TSH, progestérone… on traduit vos résultats en français, pas en hiéroglyphes.",
    cta: "Bientôt",
    available: false,
  },
];
---

<Base>
  <section class="hero section">
    <HeroBg />
    <div class="container">
      <p class="eyebrow">Sans inscription &middot; 100 % dans votre navigateur</p>
      <h1>
        Votre température a des choses à dire.<br />
        <span class="grad">On la traduit pour vous.</span>
      </h1>
      <p class="lead">
        Prenez votre courbe de <strong>BBT ("Basal-Body-Temperature")</strong> en photo (ou tapez vos températures à la main, si ça
        vous détend)&nbsp;: FertiLuna la lit, repère l'ovulation et la
        phase lutéale, et vous explique tout sans jargon et sans vous faire la
        leçon. Promis, on ne vous proposera jamais une tisane miracle.
      </p>
      <div class="hero-cta">
        <a href={TOOL} class="btn btn-primary btn-lg with-icon"
          >Analyser ma courbe <Icon name="arrow" size={18} /></a
        >
        <a href="#comment" class="btn btn-ghost">Comment ça marche</a>
      </div>
      <ul class="trust" aria-label="Points clés">
        {
          trust.map((t) => (
            <li class="with-icon">
              <Icon name="check" size={16} class="icon-accent" /> {t}
            </li>
          ))
        }
      </ul>
      <p class="privacy-note with-icon">
        <Icon name="lock" size={16} class="icon-muted" /> Vos données ne quittent
        jamais votre appareil. Pas de compte, pas de serveur qui fouine, pas de
        newsletter surprise.
      </p>
    </div>
  </section>

  <TikTokWall profile="bijoux.choux2" />

  <div class="container">
    <AdSlot
      placement="inline"
      live={adsOn}
      pubId={ads.pubId}
      slotId={ads.slots.inline}
    />
  </div>

  <section id="comment" class="section how">
    <div class="container">
      <h2>Comment ça marche</h2>
      <div class="steps">
        <div class="step">
          <span class="num">1</span>
          <h3>Importez ou tapez</h3>
          <p class="muted">
            Une capture d'écran de votre appli de suivi, ou vos températures
            jour par jour et vos tests LH. Au choix, selon votre humeur.
          </p>
        </div>
        <div class="step">
          <span class="num">2</span>
          <h3>Analyse instantanée</h3>
          <p class="muted">
            Un modèle de vision lit la courbe directement dans votre navigateur.
            Rien ne part en ligne, rien ne traîne sur un serveur.
          </p>
        </div>
        <div class="step">
          <span class="num">3</span>
          <h3>Comprenez votre cycle</h3>
          <p class="muted">
            Une courbe annotée, une explication en français clair, et les bonnes
            questions à glisser à votre médecin.
          </p>
        </div>
      </div>
      <div class="how-cta">
        <a href={TOOL} class="btn btn-primary btn-lg with-icon"
          >Commencer maintenant <Icon name="arrow" size={18} /></a
        >
      </div>
    </div>
  </section>

  <section id="outils" class="section">
    <div class="container">
      <h2>Les outils FertiLuna</h2>
      <p class="muted">
        Chaque outil est gratuit, immédiat, et pensé pour rester clair même un
        dimanche matin avant le café.
      </p>
      <div class="tool-grid">
        {
          tools.map((t) => (
            <a
              href={t.href}
              class={`tool-card card ${t.available ? "" : "soon"}`}
            >
              {t.star && (
                <span class="star with-icon">
                  <Icon name="chart" size={13} /> Outil principal
                </span>
              )}
              <h3>{t.title}</h3>
              <p class="muted">{t.desc}</p>
              <span class={`tool-cta ${t.available ? "live with-icon" : ""}`}>
                {t.cta} {t.available && <Icon name="arrow" size={16} />}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="container">
    <AdSlot
      placement="inline"
      hideMobile
      live={adsOn}
      pubId={ads.pubId}
      slotId={ads.slots.inline}
    />
  </div>

  <section class="section final-cta">
    <div class="container">
      <div class="final-card card">
        <h2>Votre courbe a un message. On vous aide à le décoder.</h2>
        <p class="muted">
          Gratuit, sans inscription, et privé&nbsp;: l'analyse se fait sur votre
          appareil, et nulle part ailleurs.
        </p>
        <a href={TOOL} class="btn btn-primary btn-lg with-icon"
          >Analyser ma courbe <Icon name="arrow" size={18} /></a
        >
      </div>
    </div>
  </section>

  <!-- Mobile-only sticky conversion bar: TikTok traffic is overwhelmingly
       mobile, so a persistent one-tap path to the tool is the highest-leverage
       conversion element on small screens. -->
  <a href={TOOL} class="sticky-cta with-icon" aria-label="Analyser ma courbe">
    Analyser ma courbe <Icon name="arrow" size={18} />
  </a>
</Base>


<style>
  /* .hero positioning + .hero-bg layering live in HeroBg.astro (shared). */
  .hero {
    padding-top: 64px;
    padding-bottom: 32px;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 800;
    margin-bottom: 0.4em;
  }
  .grad {
    background: linear-gradient(90deg, var(--rose), var(--purple));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .lead {
    font-size: 1.2rem;
    max-width: 620px;
    color: var(--ink);
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 28px 0 16px;
  }
  .btn-lg {
    padding: 16px 28px;
    font-size: 1.08rem;
  }
  .trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding: 0;
    margin: 0 0 14px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--purple);
  }
  .privacy-note {
    font-size: 0.92rem;
    color: var(--muted);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .tool-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.14s ease, box-shadow 0.14s ease;
    position: relative;
  }
  .tool-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }
  .tool-card.soon {
    opacity: 0.72;
  }
  .tool-card h3 {
    margin-top: 8px;
  }
  .star {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--rose-dark);
    background: var(--rose-soft);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .tool-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .tool-cta.live {
    color: var(--rose-dark);
  }

  .how {
    background: #fff;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
    margin-top: 24px;
  }
  .step .num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--rose);
    color: #fff;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .how-cta {
    margin-top: 32px;
  }

  .final-cta .final-card {
    text-align: center;
    background: linear-gradient(180deg, #fff, var(--rose-soft));
  }
  .final-card h2 {
    margin-bottom: 0.3em;
  }
  .final-card .btn {
    margin-top: 18px;
  }

  /* Sticky mobile CTA */
  .sticky-cta {
    display: none;
  }
  @media (max-width: 640px) {
    .sticky-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 12px;
      z-index: 60;
      padding: 15px 20px;
      border-radius: 999px;
      background: var(--rose);
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 10px 30px rgba(214, 68, 127, 0.4);
    }
    /* keep the footer clear of the sticky bar */
    :global(.site-footer) {
      padding-bottom: 84px;
    }
  }
</style>
