---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import CurveDigitizer from "../../components/CurveDigitizer.astro";
import Icon from "../../components/Icon.astro";
import { CYCLE_MAX_DAYS } from "../../lib/constants";
import { t, resolveRequestLocale, LOCALE_COOKIE } from "../../lib/i18n";
import { getAdConfig, adsLive } from "../../lib/ads";

const days = Array.from({ length: CYCLE_MAX_DAYS }, (_, i) => i + 1);

const ads = getAdConfig(Astro.locals);
const adsOn = adsLive(ads);

// Locale: trafficked-user detection (Accept-Language / country) overridden by
// the explicit ?lang= toggle, which we persist in a cookie so the choice
// survives navigation.
const override = Astro.url.searchParams.get("lang");
const country =
  (Astro.locals as { runtime?: { cf?: { country?: string } } })?.runtime?.cf
    ?.country ?? null;
const locale = resolveRequestLocale({
  override,
  cookie: Astro.cookies.get(LOCALE_COOKIE)?.value ?? null,
  acceptLanguage: Astro.request.headers.get("accept-language"),
  country,
});
if (override) {
  Astro.cookies.set(LOCALE_COOKIE, locale, {
    path: "/",
    maxAge: 60 * 60 * 24 * 365,
    sameSite: "lax",
  });
}
---

<Base
  title={t("tool.metaTitle", locale)}
  description={t("tool.metaDescription", locale)}
  locale={locale}
>
  <div class="container">
    <div class="tool-layout">
      <AdSlot
        placement="rail"
        live={adsOn}
        pubId={ads.pubId}
        slotId={ads.slots.rail}
      />

      <div class="tool-main">
        <header class="tool-head">
          <p class="eyebrow with-icon">
            <Icon name="chart" size={15} /> {t("tool.eyebrow", locale)}
          </p>
          <h1>{t("tool.h1", locale)}</h1>
          <p class="muted" set:html={t("tool.intro", locale)}></p>
        </header>

        <div class="disclaimer">
          <Icon name="alert" size={18} class="icon-purple" />
          <span>{t("consent.medical", locale)}</span>
        </div>

        <!-- ── IMPORT FROM SCREENSHOT ── -->
        <CurveDigitizer locale={locale} />

        <!-- ── INPUT ── -->
        <section id="input-panel" class="card input-card">
          <div class="data-toggle" role="group">
            <label class="chk"
              ><input type="checkbox" id="use-temp" checked /> {t("tool.useTemp", locale)}</label
            >
            <label class="chk"
              ><input type="checkbox" id="use-lh" /> {t("tool.useLh", locale)}</label
            >
          </div>

          <div class="table-scroll">
            <table class="cycle-table" id="cycle-table">
              <thead>
                <tr>
                  <th scope="col">{t("tool.colDay", locale)}</th>
                  <th scope="col" class="col-temp">{t("tool.colTemp", locale)}</th>
                  <th scope="col" class="col-lh hidden">{t("tool.colLh", locale)}</th>
                </tr>
              </thead>
              <tbody>
                {
                  days.map((d) => (
                    <tr>
                      <th scope="row">J{d}</th>
                      <td class="col-temp">
                        <input
                          type="number"
                          inputmode="decimal"
                          step="0.01"
                          min="35"
                          max="39"
                          data-kind="temp"
                          data-day={d - 1}
                          placeholder="36.5"
                          aria-label={`Température jour ${d}`}
                        />
                      </td>
                      <td class="col-lh hidden">
                        <input
                          type="number"
                          inputmode="decimal"
                          step="0.1"
                          min="0"
                          max="3"
                          data-kind="lh"
                          data-day={d - 1}
                          placeholder="1.5"
                          aria-label={`Test LH jour ${d}`}
                        />
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div class="actions">
            <button id="analyze-btn" class="btn btn-primary with-icon">
              {t("tool.analyze", locale)}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>
            <button id="demo-btn" class="btn btn-ghost"
              >{t("tool.demo", locale)}</button
            >
            <button id="clear-btn" class="btn-text">{t("tool.clear", locale)}</button>
          </div>

          <p id="model-status" class="model-status muted" aria-live="polite"></p>
        </section>

        <!-- ── RESULT (filled by JS) ── -->
        <section id="result-panel" class="result-panel" hidden></section>

        <!-- ── HISTORY (on-device, IndexedDB) — filled by JS ── -->
        <section id="history-panel" class="history card" hidden>
          <div class="history-head">
            <div>
              <h2 class="with-icon">
                <Icon name="chart" size={18} class="icon-accent" />
                {t("history.title", locale)}
              </h2>
              <p class="muted history-sub">{t("history.subtitle", locale)}</p>
            </div>
            <button id="history-clear" class="btn-text" type="button">
              {t("history.clearAll", locale)}
            </button>
          </div>
          <ul id="history-list" class="history-list"></ul>
        </section>
      </div>

      <AdSlot
        placement="rail"
        live={adsOn}
        pubId={ads.pubId}
        slotId={ads.slots.rail}
      />
    </div>
  </div>

  <!-- Mobile-only sticky bottom anchor ad. The tool page has no sticky CTA, so
       a single slim anchor here monetises mobile without cluttering content. -->
  <div class="ad-anchor-wrap">
    <AdSlot
      placement="anchor"
      live={adsOn}
      pubId={ads.pubId}
      slotId={ads.slots.bottom}
    />
  </div>
</Base>

<script>
  import { toCurveArray } from "../../lib/features";
  import {
    analyzeCycle,
    ensureModelLoaded,
    type LoadProgress,
  } from "../../lib/inference";
  import { renderCurveChart } from "../../lib/curveChart";
  import { buildResultContent } from "../../lib/resultNarrative";
  import { cachedBytes } from "../../lib/modelCache";
  import { CYCLE_MAX_DAYS } from "../../lib/constants";
  import { t, tf, toLocale } from "../../lib/i18n";
  import {
    saveRun,
    listRuns,
    getRun,
    deleteRun,
    clearRuns,
    type CycleRunSummary,
  } from "../../lib/runHistory";

  // The server set <html lang> from the resolved locale; mirror it client-side.
  const locale = toLocale(document.documentElement.lang);

  const $ = <T extends HTMLElement>(sel: string) =>
    document.querySelector(sel) as T;

  // Inline SVG icon snippets (no emoji) reused in the JS-built result markup.
  const SVG_ARROW =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
  const SVG_STETHO =
    '<svg class="ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4v5a4 4 0 0 0 8 0V4"/><path d="M6 4H4.5M14 4h1.5"/><path d="M10 17a4 4 0 0 0 8 0v-2"/><circle cx="18" cy="13" r="2"/></svg>';
  const SVG_ALERT =
    '<svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 4.3 2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4"/><circle cx="12" cy="16.6" r="0.6" fill="currentColor" stroke="none"/></svg>';

  const useTemp = $("#use-temp") as HTMLInputElement;
  const useLh = $("#use-lh") as HTMLInputElement;
  const analyzeBtn = $("#analyze-btn") as HTMLButtonElement;
  const demoBtn = $("#demo-btn") as HTMLButtonElement;
  const clearBtn = $("#clear-btn") as HTMLButtonElement;
  const statusEl = $("#model-status") as HTMLParagraphElement;
  const resultPanel = $("#result-panel") as HTMLElement;

  function syncColumns() {
    document
      .querySelectorAll<HTMLElement>(".col-temp")
      .forEach((el) => el.classList.toggle("hidden", !useTemp.checked));
    document
      .querySelectorAll<HTMLElement>(".col-lh")
      .forEach((el) => el.classList.toggle("hidden", !useLh.checked));
  }
  useTemp.addEventListener("change", syncColumns);
  useLh.addEventListener("change", syncColumns);
  syncColumns();

  function readColumn(kind: "temp" | "lh"): (number | null)[] {
    const arr: (number | null)[] = new Array(CYCLE_MAX_DAYS).fill(null);
    document
      .querySelectorAll<HTMLInputElement>(`input[data-kind="${kind}"]`)
      .forEach((inp) => {
        const day = Number(inp.dataset.day);
        const v = inp.value.trim().replace(",", ".");
        if (v !== "") {
          const num = Number(v);
          if (Number.isFinite(num)) arr[day] = num;
        }
      });
    return arr;
  }

  function setStatus(msg: string) {
    statusEl.textContent = msg;
  }

  // Warm the cycle model on first sign of intent (focusing the input table,
  // hovering Analyze, or hitting the demo button), NOT eagerly on page load.
  // ORT's wasm compile + ONNX session init is heavy main-thread work (~seconds
  // of blocking time); doing it on load tanked mobile Lighthouse TBT for every
  // visitor, including those who only read the page. ensureModelLoaded() is
  // idempotent and the Analyze handler awaits it anyway, so warming on intent
  // keeps the first analysis feeling instant while keeping initial load light.
  let modelWarmArmed = false;
  function warmModel() {
    if (modelWarmArmed) return;
    modelWarmArmed = true;
    ensureModelLoaded((p: LoadProgress) => reportLoad(p)).then(
      async () => {
        const bytes = await cachedBytes();
        if (bytes > 0)
          setStatus(
            tf("tool.modelReady", locale, { mb: (bytes / 1e6).toFixed(1) }),
          );
      },
      () => setStatus(""),
    );
  }
  const inputPanel = $("#input-panel") as HTMLElement;
  inputPanel.addEventListener("focusin", warmModel, { once: true });
  inputPanel.addEventListener("pointerenter", warmModel, { once: true });
  demoBtn.addEventListener("pointerenter", warmModel, { once: true });
  analyzeBtn.addEventListener("pointerenter", warmModel, { once: true });

  function reportLoad(p: LoadProgress) {
    if (p.phase === "ready") return;
    if (p.file && p.file.total > 0) {
      const pct = Math.round((p.file.loaded / p.file.total) * 100);
      setStatus(tf("tool.modelLoading", locale, { pct }));
    } else {
      setStatus(t("tool.modelPreparing", locale));
    }
  }

  demoBtn.addEventListener("click", () => {
    // A clean ovulatory cycle: low follicular, clear rise at ~J15, stable plateau.
    const temps = [
      36.4, 36.35, 36.42, 36.38, 36.41, 36.37, 36.4, 36.36, 36.39, 36.35,
      36.41, 36.34, 36.3, 36.28, 36.55, 36.72, 36.78, 36.8, 36.79, 36.82,
      36.81, 36.83, 36.8, 36.79, 36.81, 36.78, 36.77, 36.62, null, null, null,
      null, null, null, null,
    ];
    const lh = new Array(CYCLE_MAX_DAYS).fill(null) as (number | null)[];
    lh[12] = 1.1;
    lh[13] = 2.6;
    lh[14] = 1.4;
    useLh.checked = true;
    syncColumns();
    document
      .querySelectorAll<HTMLInputElement>('input[data-kind="temp"]')
      .forEach((inp) => {
        const day = Number(inp.dataset.day);
        inp.value = temps[day] == null ? "" : String(temps[day]);
      });
    document
      .querySelectorAll<HTMLInputElement>('input[data-kind="lh"]')
      .forEach((inp) => {
        const day = Number(inp.dataset.day);
        inp.value = lh[day] == null ? "" : String(lh[day]);
      });
  });

  clearBtn.addEventListener("click", () => {
    document
      .querySelectorAll<HTMLInputElement>("input[data-kind]")
      .forEach((inp) => (inp.value = ""));
    resultPanel.hidden = true;
    resultPanel.innerHTML = "";
  });

  // Screenshot digitizer → fill the temperature and/or LH columns. The user
  // always lands back in the editable table to verify/correct the recovered
  // values before analysing (human-in-the-loop), which is what makes the CV
  // approach robust on busy, dual-axis charts.
  document.addEventListener("fertiluna:digitized", (ev) => {
    const detail = (
      ev as CustomEvent<{
        temps: (number | null)[] | null;
        lh: (number | null)[] | null;
      }>
    ).detail;
    if (!detail) return;

    let filled = 0;
    if (detail.temps) {
      useTemp.checked = true;
      const temps = detail.temps;
      document
        .querySelectorAll<HTMLInputElement>('input[data-kind="temp"]')
        .forEach((inp) => {
          const day = Number(inp.dataset.day);
          const v = temps[day];
          inp.value = v == null ? "" : String(v);
          if (v != null) filled++;
        });
    }
    if (detail.lh) {
      useLh.checked = true;
      const lh = detail.lh;
      document
        .querySelectorAll<HTMLInputElement>('input[data-kind="lh"]')
        .forEach((inp) => {
          const day = Number(inp.dataset.day);
          const v = lh[day];
          inp.value = v == null ? "" : String(v);
          if (v != null) filled++;
        });
    }
    syncColumns();
    setStatus(tf("tool.imported", locale, { n: filled }));
    $("#input-panel").scrollIntoView({ behavior: "smooth", block: "start" });
  });

  async function runAnalysis() {
    const tempsRaw = useTemp.checked
      ? readColumn("temp")
      : new Array(CYCLE_MAX_DAYS).fill(null);
    const lhRaw = useLh.checked
      ? readColumn("lh")
      : new Array(CYCLE_MAX_DAYS).fill(null);

    const filled =
      tempsRaw.filter((v) => v != null).length +
      lhRaw.filter((v) => v != null).length;
    if (filled < 5) {
      setStatus(t("tool.needData", locale));
      return;
    }

    analyzeBtn.disabled = true;
    analyzeBtn.textContent = t("tool.analyzing", locale);
    try {
      await ensureModelLoaded((p) => reportLoad(p));
      const temps = toCurveArray(tempsRaw);
      const lh = toCurveArray(lhRaw);
      const analysis = await analyzeCycle(temps, lh);
      renderResult(tempsRaw, lhRaw, analysis);
      setStatus("");
    } catch (err) {
      console.error(err);
      setStatus(t("tool.error", locale));
    } finally {
      analyzeBtn.disabled = false;
      analyzeBtn.innerHTML = `${t("tool.analyze", locale)} ${SVG_ARROW}`;
    }
  }

  analyzeBtn.addEventListener("click", () => void runAnalysis());

  function esc(s: string): string {
    const d = document.createElement("div");
    d.textContent = s;
    return d.innerHTML;
  }

  function renderResult(
    tempsRaw: (number | null)[],
    lhRaw: (number | null)[],
    analysis: Awaited<ReturnType<typeof analyzeCycle>>,
    opts: { persist?: boolean } = {},
  ) {
    const c = buildResultContent(analysis, locale);
    const chart = renderCurveChart({
      temps: tempsRaw,
      lh: lhRaw,
      ovulationDay: analysis.derived.estimatedOvulationDay,
    });

    const chips = c.chips
      .map(
        (chip) => `
        <div class="chip" ${chip.hint ? `title="${esc(chip.hint)}"` : ""}>
          <span class="chip-val">${esc(chip.value)}</span>
          <span class="chip-label">${esc(chip.label)}</span>
        </div>`,
      )
      .join("");

    // Inject an inline ad slot after the 2nd narrative section for engagement.
    const narrative = c.narrative
      .map(
        (n, i) => `
        <div class="narr-section">
          <h3>${esc(n.heading)}</h3>
          <p>${esc(n.body)}</p>
        </div>
        ${i === 1 ? '<aside class="ad-slot ad-inline" aria-hidden="true">Espace publicitaire</aside>' : ""}`,
      )
      .join("");

    const doctorQ = c.doctorQuestions.length
      ? `<div class="doctor-card">
           <h3 class="with-icon">${SVG_STETHO} ${esc(t("tool.doctorTitle", locale))}</h3>
           <ul>${c.doctorQuestions.map((q) => `<li>${esc(q)}</li>`).join("")}</ul>
         </div>`
      : "";

    const glossary = c.glossary.length
      ? `<details class="glossary">
           <summary>${esc(t("tool.glossaryTitle", locale))}</summary>
           <dl>${c.glossary
             .map(
               (g) =>
                 `<dt>${esc(g.term)}</dt><dd>${esc(g.definition)}</dd>`,
             )
             .join("")}</dl>
         </details>`
      : "";

    const oodNote = c.oodNote
      ? `<p class="ood-note">${esc(c.oodNote)}</p>`
      : "";

    const confidenceBadge = c.confident
      ? `<span class="conf-badge ok">${esc(tf("tool.confidence", locale, { pct: c.confidencePct }))}</span>`
      : `<span class="conf-badge low">${esc(tf("tool.confidenceLow", locale, { pct: c.confidencePct }))}</span>`;

    resultPanel.innerHTML = `
      <div class="result-verdict card tone-${c.tone}">
        <div class="verdict-head">
          <h2>${esc(c.title)}</h2>
          ${confidenceBadge}
        </div>
        <p class="verdict-summary">${esc(c.summary)}</p>
        ${oodNote}
      </div>

      <div class="card chart-card">
        ${chart}
        <p class="chart-legend">
          <span class="dot rose"></span> ${esc(t("tool.legendFollicular", locale))}
          <span class="dot purple"></span> ${esc(t("tool.legendLuteal", locale))}
          <span class="dot amber"></span> ${esc(t("tool.legendLhPeak", locale))}
        </p>
      </div>

      ${chips ? `<div class="chips">${chips}</div>` : ""}

      <div class="narrative">${narrative}</div>

      ${doctorQ}
      ${glossary}

      <div class="result-footer disclaimer">
        ${SVG_ALERT}
        <span>${esc(t("tool.resultDisclaimer", locale))}</span>
      </div>
    `;
    resultPanel.hidden = false;
    resultPanel.scrollIntoView({ behavior: "smooth", block: "start" });

    // Persist this run to on-device history (best-effort; never blocks the UI).
    // Skipped when re-rendering an already-saved run (reopen), to avoid dupes.
    if (opts.persist !== false) void saveCurrentRun(tempsRaw, lhRaw, c, chart, analysis);
  }

  // ── On-device history (IndexedDB via Dexie) ──────────────────────────────
  const historyPanel = $("#history-panel") as HTMLElement;
  const historyList = $("#history-list") as HTMLUListElement;
  const historyClear = $("#history-clear") as HTMLButtonElement;

  /** Downscale the imported screenshot (if any) to a small JPEG thumbnail.
   *  Returns null unless the digitizer actually loaded an image — otherwise the
   *  #auto-canvas still has its default 300x150 size and we'd capture a blank
   *  (black) frame. The auto panel gets `.has-image` once a screenshot loads. */
  function makeThumbnail(): string | null {
    const panel = document.getElementById("auto-panel");
    if (!panel || !panel.classList.contains("has-image")) return null;
    const cv = document.getElementById("auto-canvas") as HTMLCanvasElement | null;
    if (!cv || !cv.width || !cv.height) return null;
    const max = 200;
    const scale = Math.min(max / cv.width, max / cv.height, 1);
    const w = Math.max(1, Math.round(cv.width * scale));
    const h = Math.max(1, Math.round(cv.height * scale));
    const off = document.createElement("canvas");
    off.width = w;
    off.height = h;
    const ctx = off.getContext("2d");
    if (!ctx) return null;
    try {
      ctx.drawImage(cv, 0, 0, w, h);
      return off.toDataURL("image/jpeg", 0.7);
    } catch {
      return null; // tainted canvas / unsupported — skip the thumbnail.
    }
  }

  async function saveCurrentRun(
    tempsRaw: (number | null)[],
    lhRaw: (number | null)[],
    c: ReturnType<typeof buildResultContent>,
    chartSvg: string,
    analysis: Awaited<ReturnType<typeof analyzeCycle>>,
  ) {
    const id = await saveRun({
      createdAt: Date.now(),
      locale,
      title: c.title,
      summary: c.summary,
      tone: c.tone,
      confidencePct: c.confidencePct,
      thumbnail: makeThumbnail(),
      chartSvg,
      temps: tempsRaw,
      lh: lhRaw,
      analysis,
    });
    if (id != null) {
      setStatus(t("history.saved", locale));
      void refreshHistory();
    }
  }

  function fmtDate(ts: number): string {
    try {
      return new Intl.DateTimeFormat(locale, {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(new Date(ts));
    } catch {
      return new Date(ts).toLocaleString();
    }
  }

  function renderHistory(runs: CycleRunSummary[]) {
    if (!runs.length) {
      historyPanel.hidden = true;
      return;
    }
    historyPanel.hidden = false;
    historyList.innerHTML = runs
      .map((r) => {
        const thumb = r.thumbnail
          ? `<img class="history-thumb" src="${r.thumbnail}" alt="" loading="lazy" />`
          : `<span class="history-thumb history-thumb--empty" aria-hidden="true">${SVG_STETHO}</span>`;
        return `
        <li class="history-item" data-id="${r.id}">
          ${thumb}
          <div class="history-meta">
            <span class="history-when">${esc(fmtDate(r.createdAt))}</span>
            <strong class="history-verdict tone-${esc(r.tone)}">${esc(r.title)}</strong>
            <span class="history-summary">${esc(r.summary)}</span>
          </div>
          <div class="history-actions">
            <button type="button" class="history-btn history-open" data-id="${r.id}">${esc(t("history.open", locale))}</button>
            <button type="button" class="history-btn history-del" data-id="${r.id}" aria-label="${esc(t("history.delete", locale))}">${esc(t("history.delete", locale))}</button>
          </div>
        </li>`;
      })
      .join("");
  }

  async function refreshHistory() {
    renderHistory(await listRuns());
  }

  async function reopenRun(id: number) {
    const run = await getRun(id);
    if (!run) return;
    const hasTemp = run.temps.some((v) => v != null);
    const hasLh = run.lh.some((v) => v != null);
    useTemp.checked = hasTemp;
    useLh.checked = hasLh || !hasTemp; // keep at least one column visible
    syncColumns();
    document
      .querySelectorAll<HTMLInputElement>('input[data-kind="temp"]')
      .forEach((inp) => {
        const v = run.temps[Number(inp.dataset.day)];
        inp.value = v == null ? "" : String(v);
      });
    document
      .querySelectorAll<HTMLInputElement>('input[data-kind="lh"]')
      .forEach((inp) => {
        const v = run.lh[Number(inp.dataset.day)];
        inp.value = v == null ? "" : String(v);
      });
    setStatus(t("history.restored", locale));
    // Re-render the stored result instantly (offline, no model, no duplicate).
    // If the analysis JSON is missing (older entry), fall back to recomputing.
    if (run.analysis) {
      renderResult(
        run.temps,
        run.lh,
        run.analysis as Awaited<ReturnType<typeof analyzeCycle>>,
        { persist: false },
      );
    } else {
      void runAnalysis();
    }
  }

  // Event delegation for per-item open / delete.
  historyList.addEventListener("click", (ev) => {
    const btn = (ev.target as HTMLElement).closest("button");
    if (!btn) return;
    const id = Number(btn.dataset.id);
    if (!Number.isFinite(id)) return;
    if (btn.classList.contains("history-open")) void reopenRun(id);
    else if (btn.classList.contains("history-del"))
      void deleteRun(id).then(refreshHistory);
  });

  historyClear.addEventListener("click", () => {
    if (!confirm(t("history.clearConfirm", locale))) return;
    void clearRuns().then(refreshHistory);
  });

  // Populate history on load.
  void refreshHistory();
</script>

